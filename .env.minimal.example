# Optional defaults for minimal; copy to .env. Leave optional values empty.
TOKEN_MONITOR_CLIENTS=codex,claude,antigravity
TOKEN_MONITOR_INTERVAL_MS=60000
TOKEN_MONITOR_WATCH=0
TOKEN_MONITOR_LIMITS_ENABLED=1
TOKEN_MONITOR_LIMITS_REFRESH_MS=300000
TOKEN_MONITOR_ALL_TIME_SINCE=2024-01-01
TOKEN_MONITOR_DEVICE_ID=
TOKEN_MONITOR_MINIMAL_HOST=127.0.0.1
TOKEN_MONITOR_MINIMAL_PORT=17322
# Required for a non-loopback listener; also used for optional Hub authentication.
TOKEN_MONITOR_SECRET=
# Optional: existing Hub to receive this device's aggregate snapshots.
TOKEN_MONITOR_HUB_URL=
# Optional: private JSON file with already authorized managed quota accounts.
TOKEN_MONITOR_MINIMAL_ACCOUNTS_FILE=

# Headless API only; enable explicitly for the optional browser dashboard.
TOKEN_MONITOR_MINIMAL_WEB=0
# Optional TUI base URL; by default it discovers the managed local service.
TOKEN_MONITOR_TUI_URL=
